# Copy to .env (never commit .env). Required for the `dev` profile (PostgreSQL).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticket_db
POSTGRES_USER=ticket
POSTGRES_PASSWORD=

# Comma-separated browser origins allowed to call /api/**
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: in-memory H2 for the `local` profile
H2_USER=sa
H2_PASSWORD=